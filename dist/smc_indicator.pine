//@version=6
// Risk-Averse FX — SMC/ICT model v2 — INDICATOR. Generated by pine/build.py from pine/smc_core.pine. Do not edit here.
// Chart: 15m, FX:EURUSD etc. Backtest verdict in reports/research.md: no out-of-sample edge; discipline tool.
indicator("Risk-Averse FX SMC v2", "RAFX SMC v2", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, calc_bars_count=20000)
// Risk-Averse FX — SMC / ICT model v2 (shared core). Edit this, then run pine/build.py.
// Concepts: multi-timeframe structure bias (Daily / 4H / 1H), 15m market structure (swings, BOS, CHoCH),
// liquidity sweeps, displacement, order-block limit entry, SL below the block, TP1/TP2/TP3 scale-out with
// stop to breakeven after TP1, lot size for fixed % risk, sessions/news gating, daily loss limit.
// BACKTEST VERDICT (reports/research.md): no positive expectancy out-of-sample. Use as a discipline tool.
// Python mirror: py/fx/smc.py + py/research_smc.py (run_smc).

// ───────────────────────────── Inputs
grpS = "SMC model"
PIV        = input.int(3,    "Swing pivot length (bars each side)", minval=2, maxval=10, group=grpS)
dispAtr    = input.float(1.0, "Displacement candle body ≥ ATR ×", minval=0.3, step=0.1, group=grpS)
obLook     = input.int(5,    "Order block: look back N bars for last opposite candle", minval=1, maxval=10, group=grpS)
obValid    = input.int(12,   "Limit order valid for N bars", minval=1, group=grpS)
entryMid   = input.bool(false, "Enter at 50% of the order block (else at its top/bottom)", group=grpS)
requireSweep = input.bool(false, "Require a liquidity sweep within 8 bars before displacement", group=grpS)
useBiasD   = input.bool(true, "Bias: Daily structure", group=grpS)
useBias4h  = input.bool(true, "Bias: 4H structure", group=grpS)
useBias1h  = input.bool(true, "Bias: 1H structure", group=grpS)

grpR = "Risk"
slBufAtr   = input.float(0.1, "SL buffer below/above block (ATR ×)", minval=0, step=0.05, group=grpR)
minSlAtr   = input.float(0.8, "Minimum stop distance (ATR ×)", minval=0.2, step=0.1, group=grpR)
maxSlAtr   = input.float(3.0, "Skip if stop distance > ATR ×", minval=1, step=0.5, group=grpR)
tp1R       = input.float(1.0, "TP1 (R)", minval=0.25, step=0.25, group=grpR)
tp2R       = input.float(2.0, "TP2 (R)", minval=0.5, step=0.25, group=grpR)
tp3R       = input.float(3.0, "TP3 (R)", minval=0.5, step=0.25, group=grpR)
beAfterTp1 = input.bool(true, "Move stop to breakeven after TP1", group=grpR)
equity     = input.float(10000, "Account equity (USD)", minval=1, group=grpR)
riskPct    = input.float(0.5, "Risk per trade (%)", minval=0.05, step=0.05, group=grpR)
spreadPips = input.float(1.0, "Spread + slippage assumed on entry (pips)", minval=0, step=0.1, group=grpR)
pipValOverride = input.float(0, "Pip value per 1.0 lot in USD (0 = auto)", minval=0, group=grpR)
maxSigDay  = input.int(2, "Max setups per day", minval=1, group=grpR)
minBarsBetween = input.int(8, "Min bars between setups", minval=1, group=grpR)
maxLossDay = input.int(2, "Go silent after N losses in a day", minval=1, group=grpR)
maxDayR    = input.float(2.0, "Go silent after day loss of R ≥", minval=0.5, step=0.5, group=grpR)

grpF = "Filters (all times UTC)"
sess1        = input.session("0715-1045", "Session 1", group=grpF)
sess2        = input.session("1345-1600", "Session 2", group=grpF)
news1        = input.session("1225-1305", "News blackout 1", group=grpF)
news2        = input.session("1355-1420", "News blackout 2", group=grpF)
fridayCutoff = input.int(15, "Friday: no setups from hour", minval=0, maxval=23, group=grpF)
blackoutDates = input.string("", "Blackout dates (YYYY-MM-DD, comma separated)", group=grpF)
useAtrBand   = input.bool(true, "ATR band filter (skip too quiet / too wild)", group=grpF)

grpD = "Display"
dispTz     = input.string("Asia/Karachi", "Display timezone", group=grpD)
showTable  = input.bool(true, "Status table", group=grpD)
showStruct = input.bool(true, "Structure: swings, BOS/CHoCH, sweeps", group=grpD)
showOB     = input.bool(true, "Order block boxes", group=grpD)

// ───────────────────────────── 15m basics
atr    = ta.atr(14)
atrLo  = ta.percentile_nearest_rank(atr, 480, 20)
atrHi  = ta.percentile_nearest_rank(atr, 480, 95)
rng    = high - low
body   = math.abs(close - open)
spike  = rng > 3.0 * atr[1]
spikeRecent = spike or spike[1] or spike[2] or spike[3]
dOk = not useAtrBand or (atr >= atrLo and atr <= atrHi and not spikeRecent)

// ───────────────────────────── Sessions
inSess  = not na(time(timeframe.period, sess1 + ":23456", "UTC")) or not na(time(timeframe.period, sess2 + ":23456", "UTC"))
inNews  = not na(time(timeframe.period, news1 + ":23456", "UTC")) or not na(time(timeframe.period, news2 + ":23456", "UTC"))
fridayBlock = dayofweek(time, "UTC") == dayofweek.friday and hour(time, "UTC") >= fridayCutoff
var string[] blackoutArr = str.split(str.replace_all(blackoutDates, " ", ""), ",")
dateBlocked = blackoutDates != "" and array.includes(blackoutArr, str.format_time(time, "yyyy-MM-dd", "UTC"))
eOk = inSess and not inNews and not fridayBlock and not dateBlocked

// ───────────────────────────── Market structure (swings -> BOS / CHoCH), same order as py/fx/smc.py
// Returns [trend, swingHigh, swingLow, bosUp, bosDn, sweepLo, sweepHi]
f_structure(int n) =>
    float ph = ta.pivothigh(high, n, n)
    float pl = ta.pivotlow(low, n, n)
    var float sh = na
    var float sl = na
    var int   t  = 0
    bool sweepLo = not na(sl) and low < sl and close > sl
    bool sweepHi = not na(sh) and high > sh and close < sh
    bool bosUp = false
    bool bosDn = false
    if not na(sh) and close > sh
        bosUp := true
        t := 1
        sh := na
    if not na(sl) and close < sl
        bosDn := true
        t := -1
        sl := na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    [t, sh, sl, bosUp, bosDn, sweepLo, sweepHi]

[trend15, sh15, sl15, bosUp, bosDn, sweepLo, sweepHi] = f_structure(PIV)

f_trendOnly() =>
    [t, _a, _b, _c, _d, _e, _f] = f_structure(PIV)
    t
biasD  = request.security(syminfo.tickerid, "D",   f_trendOnly()[1], lookahead=barmerge.lookahead_on)
bias4h = request.security(syminfo.tickerid, "240", f_trendOnly()[1], lookahead=barmerge.lookahead_on)
bias1h = request.security(syminfo.tickerid, "60",  f_trendOnly()[1], lookahead=barmerge.lookahead_on)
biasLong  = (not useBiasD or biasD == 1)  and (not useBias4h or bias4h == 1)  and (not useBias1h or bias1h == 1)
biasShort = (not useBiasD or biasD == -1) and (not useBias4h or bias4h == -1) and (not useBias1h or bias1h == -1)

// ───────────────────────────── Displacement + order block
dispUp = close > open and body >= dispAtr * atr and close > ta.highest(high, 5)[1]
dispDn = close < open and body >= dispAtr * atr and close < ta.lowest(low, 5)[1]
f_ob(bool bullish) =>
    float top = na
    float bot = na
    for k = 1 to obLook
        if bullish and close[k] < open[k]
            top := open[k]
            bot := low[k]
            break
        if not bullish and close[k] > open[k]
            top := high[k]
            bot := open[k]
            break
    [top, bot]
[obTopL, obBotL] = f_ob(true)
[obTopS, obBotS] = f_ob(false)
sinceSweepLo = ta.barssince(sweepLo)
sinceSweepHi = ta.barssince(sweepHi)
sweepOkL = not requireSweep or (sinceSweepLo >= 1 and sinceSweepLo <= 8)
sweepOkS = not requireSweep or (sinceSweepHi >= 1 and sinceSweepHi <= 8)
setupLong  = dispUp and not na(obTopL) and biasLong  and sweepOkL and eOk and dOk
setupShort = dispDn and not na(obTopS) and biasShort and sweepOkS and eOk and dOk

// ───────────────────────────── Lot sizing
pipSize = syminfo.mintick * 10
f_pipValueUsd() =>
    float v = na
    if pipValOverride > 0
        v := pipValOverride
    else if syminfo.currency == "USD"
        v := 100000 * pipSize
    else if syminfo.basecurrency == "USD"
        v := 100000 * pipSize / close
    else
        v := 100000 * pipSize
    v
f_lots(float dist) =>
    math.floor((equity * riskPct / 100) / (dist / pipSize * f_pipValueUsd()) * 100) / 100

// ───────────────────────────── State (confirmed bars only)
var int   openDir    = 0
var int   pendDir    = 0
var int   pendUntil  = 0
var float lvl        = na
var float zoneBot    = na
var float fill       = na
var float slPx       = na
var float slDist     = na
var float tp1        = na
var float tp2        = na
var float tp3        = na
var int   partsLeft  = 0
var float rAcc       = 0.0
var int   entryBar   = na
var int   lastSigBar = -100000
var int   daySignals = 0
var int   dayLosses  = 0
var float dayR       = 0.0
var bool  dayStopped = false
var int   totWins    = 0
var int   totLosses  = 0
var float totR       = 0.0
var box   obBox      = na
var line  slLine     = na
var line  tp1Line    = na
var line  tp2Line    = na
var line  tp3Line    = na

dayKey = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
newDay = ta.change(dayKey) != 0
spreadPx = spreadPips * pipSize
bool sigLongNow  = false
bool sigShortNow = false
bool filledNow   = false

if barstate.isconfirmed
    if newDay
        daySignals := 0
        dayLosses  := 0
        dayR       := 0.0
        dayStopped := false
    // 1. pending limit order
    if pendDir != 0
        int d = pendDir
        bool touched = d > 0 ? low <= lvl : high >= lvl
        if touched
            float px = d > 0 ? math.min(open, lvl) : math.max(open, lvl)
            fill      := px + d * spreadPx
            openDir   := d
            pendDir   := 0
            entryBar  := bar_index
            partsLeft := 3
            rAcc      := 0.0
            tp1 := fill + d * tp1R * slDist
            tp2 := fill + d * tp2R * slDist
            tp3 := fill + d * tp3R * slDist
            filledNow := true
            if not na(tp1Line)
                line.set_y1(tp1Line, tp1)
                line.set_y2(tp1Line, tp1)
                line.set_y1(tp2Line, tp2)
                line.set_y2(tp2Line, tp2)
                line.set_y1(tp3Line, tp3)
                line.set_y2(tp3Line, tp3)
        else if bar_index >= pendUntil or (d > 0 ? close < zoneBot : close > zoneBot)
            pendDir := 0
            if not na(obBox)
                box.set_border_style(obBox, line.style_dotted)
    // 2. open trade: SL first, then TPs
    if openDir != 0
        int d = openDir
        bool hitSl = d > 0 ? low <= slPx : high >= slPx
        if hitSl
            rAcc += (slPx - fill) / slDist * d * (partsLeft / 3.0)
            partsLeft := 0
        else
            int k = 3 - partsLeft
            bool more = true
            while partsLeft > 0 and more
                float tpk = k == 0 ? tp1 : k == 1 ? tp2 : tp3
                bool hit = d > 0 ? high >= tpk : low <= tpk
                if hit
                    rAcc += (tpk - fill) / slDist * d / 3.0
                    partsLeft -= 1
                    k += 1
                    if beAfterTp1 and partsLeft > 0
                        slPx := fill
                        if not na(slLine)
                            line.set_y1(slLine, slPx)
                            line.set_y2(slLine, slPx)
                    label.new(bar_index, d > 0 ? high : low, "TP" + str.tostring(k), style=d > 0 ? label.style_label_down : label.style_label_up,
                         color=color.new(color.teal, 40), textcolor=color.white, size=size.tiny)
                else
                    more := false
        if partsLeft == 0
            dayR += rAcc
            totR += rAcc
            if rAcc < 0
                dayLosses += 1
                totLosses += 1
            else
                totWins += 1
            if dayLosses >= maxLossDay or dayR <= -maxDayR
                dayStopped := true
            if not na(slLine)
                line.set_x2(slLine, bar_index)
                line.set_x2(tp1Line, bar_index)
                line.set_x2(tp2Line, bar_index)
                line.set_x2(tp3Line, bar_index)
            label.new(bar_index, rAcc < 0 ? low : high, (rAcc >= 0 ? "+" : "") + str.tostring(rAcc, "0.00") + "R",
                 style=rAcc < 0 ? label.style_label_up : label.style_label_down,
                 color=rAcc < 0 ? color.new(color.red, 20) : color.new(color.teal, 20), textcolor=color.white, size=size.small)
            openDir := 0
        else if not na(slLine)
            line.set_x2(slLine, bar_index + 1)
            line.set_x2(tp1Line, bar_index + 1)
            line.set_x2(tp2Line, bar_index + 1)
            line.set_x2(tp3Line, bar_index + 1)
    // 3. new setup
    bool throttleOk = openDir == 0 and pendDir == 0 and not dayStopped and daySignals < maxSigDay and bar_index - lastSigBar >= minBarsBetween
    if throttleOk and not na(atr) and (setupLong or setupShort)
        int d = setupLong ? 1 : -1
        float top = d > 0 ? obTopL : obTopS
        float bot = d > 0 ? obBotL : obBotS
        float entryLvl = entryMid ? (top + bot) / 2 : (d > 0 ? top : bot)
        float stop = d > 0 ? bot - slBufAtr * atr : top + slBufAtr * atr
        float dist = math.abs(entryLvl - stop)
        if dist < minSlAtr * atr
            dist := minSlAtr * atr
            stop := entryLvl - d * dist
        bool priceOk = d > 0 ? close > entryLvl : close < entryLvl
        if dist <= maxSlAtr * atr and priceOk
            pendDir   := d
            pendUntil := bar_index + obValid
            lvl       := entryLvl
            zoneBot   := d > 0 ? bot : top
            slPx      := stop
            slDist    := dist
            lastSigBar := bar_index
            daySignals += 1
            sigLongNow  := d > 0
            sigShortNow := d < 0
            float lots = f_lots(dist)
            float t1 = entryLvl + d * tp1R * dist
            float t2 = entryLvl + d * tp2R * dist
            float t3 = entryLvl + d * tp3R * dist
            string txt = (d > 0 ? "▲ BUY LIMIT" : "▼ SELL LIMIT") + " @ " + str.tostring(entryLvl, format.mintick) +
                 "\nSL " + str.tostring(stop, format.mintick) + " (" + str.tostring(dist / pipSize, "0.0") + "p)" +
                 "\nTP1 " + str.tostring(t1, format.mintick) + "  TP2 " + str.tostring(t2, format.mintick) + "  TP3 " + str.tostring(t3, format.mintick) +
                 "\nR:R 1:" + str.tostring(tp1R, "0.0") + " / 1:" + str.tostring(tp2R, "0.0") + " / 1:" + str.tostring(tp3R, "0.0") +
                 "\n" + str.tostring(lots, "0.00") + " lot @ " + str.tostring(riskPct, "0.00") + "%  valid " + str.tostring(obValid) + " bars"
            label.new(bar_index, d > 0 ? low : high, txt, style=d > 0 ? label.style_label_up : label.style_label_down,
                 color=d > 0 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor=color.white, size=size.normal)
            if showOB
                obBox := box.new(bar_index - 1, top, bar_index + obValid, bot, border_color=d > 0 ? color.green : color.red,
                     bgcolor=d > 0 ? color.new(color.green, 85) : color.new(color.red, 85))
            slLine  := line.new(bar_index, stop, bar_index + 1, stop, color=color.red, width=2)
            tp1Line := line.new(bar_index, t1, bar_index + 1, t1, color=color.new(color.teal, 40), width=1)
            tp2Line := line.new(bar_index, t2, bar_index + 1, t2, color=color.new(color.teal, 20), width=1)
            tp3Line := line.new(bar_index, t3, bar_index + 1, t3, color=color.teal, width=2)
            string amsg = syminfo.ticker + " " + (d > 0 ? "BUY LIMIT" : "SELL LIMIT") + " " + str.tostring(entryLvl, format.mintick) +
                 " | SL " + str.tostring(stop, format.mintick) + " | TP1 " + str.tostring(t1, format.mintick) +
                 " TP2 " + str.tostring(t2, format.mintick) + " TP3 " + str.tostring(t3, format.mintick) +
                 " | " + str.tostring(lots, "0.00") + " lot | valid " + str.tostring(obValid) + " bars | " +
                 str.format_time(time_close, "HH:mm", dispTz) + " " + dispTz
            alert(amsg, alert.freq_once_per_bar_close)

// ───────────────────────────── Structure drawing
plotshape(showStruct and bosUp and trend15[1] != 1,  "CHoCH up",   shape.labelup,   location.belowbar, color.new(color.green, 30), text="CHoCH", textcolor=color.white, size=size.tiny)
plotshape(showStruct and bosUp and trend15[1] == 1,  "BOS up",     shape.labelup,   location.belowbar, color.new(color.green, 60), text="BOS",   textcolor=color.white, size=size.tiny)
plotshape(showStruct and bosDn and trend15[1] != -1, "CHoCH down", shape.labeldown, location.abovebar, color.new(color.red, 30),   text="CHoCH", textcolor=color.white, size=size.tiny)
plotshape(showStruct and bosDn and trend15[1] == -1, "BOS down",   shape.labeldown, location.abovebar, color.new(color.red, 60),   text="BOS",   textcolor=color.white, size=size.tiny)
plotshape(showStruct and sweepLo, "Sell-side liquidity sweep", shape.diamond, location.belowbar, color.new(color.aqua, 0), size=size.tiny)
plotshape(showStruct and sweepHi, "Buy-side liquidity sweep",  shape.diamond, location.abovebar, color.new(color.fuchsia, 0), size=size.tiny)
plot(showStruct ? sh15 : na, "Swing high (liquidity)", color=color.new(color.fuchsia, 50), style=plot.style_linebr, linewidth=1)
plot(showStruct ? sl15 : na, "Swing low (liquidity)",  color=color.new(color.aqua, 50),    style=plot.style_linebr, linewidth=1)
bgcolor(eOk ? color.new(color.green, 94) : na, title="Allowed session")
bgcolor(inNews and inSess ? color.new(color.red, 88) : na, title="News blackout")
plotshape(sigLongNow,  "Long setup",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(sigShortNow, "Short setup", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small)

alertcondition(sigLongNow,  "Long setup (buy limit)",   "Long setup on {{ticker}} — open chart for levels")
alertcondition(sigShortNow, "Short setup (sell limit)", "Short setup on {{ticker}} — open chart for levels")
alertcondition(sigLongNow or sigShortNow, "Any setup",  "Setup on {{ticker}} — open chart for levels")
alertcondition(filledNow, "Limit filled", "Limit order filled on {{ticker}}")

// ───────────────────────────── Status table
var table tbl = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 60))
f_cell(int row, string k, string v, color c) =>
    table.cell(tbl, 0, row, k, text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, row, v, text_color=c, text_size=size.small, text_halign=text.align_right)
f_biasTxt(int b) =>
    b == 1 ? "Bullish" : b == -1 ? "Bearish" : "None"
f_biasCol(int b) =>
    b == 1 ? color.lime : b == -1 ? color.orange : color.gray
if showTable and barstate.islast
    string sessTxt = not inSess ? "closed" : inNews ? "NEWS BLACKOUT" : fridayBlock ? "Friday cutoff" : dateBlocked ? "blackout date" : "OPEN"
    string status = openDir != 0 ? "IN TRADE (" + (openDir > 0 ? "long" : "short") + ", " + str.tostring(partsLeft) + "/3 left)" :
         pendDir != 0 ? (pendDir > 0 ? "BUY" : "SELL") + " LIMIT working (" + str.tostring(pendUntil - bar_index) + " bars)" :
         dayStopped ? "DAY STOPPED" : eOk ? "watching" : "waiting for session"
    color statC = dayStopped ? color.red : openDir != 0 ? color.yellow : pendDir != 0 ? color.aqua : eOk ? color.lime : color.gray
    f_cell(0, "SMC v2", str.format_time(timenow, "EEE HH:mm", dispTz) + " " + dispTz, color.white)
    f_cell(1, "Daily bias", f_biasTxt(biasD) + (useBiasD ? "" : " (off)"), f_biasCol(biasD))
    f_cell(2, "4H bias", f_biasTxt(bias4h) + (useBias4h ? "" : " (off)"), f_biasCol(bias4h))
    f_cell(3, "1H bias", f_biasTxt(bias1h) + (useBias1h ? "" : " (off)"), f_biasCol(bias1h))
    f_cell(4, "15m structure", f_biasTxt(trend15), f_biasCol(trend15))
    f_cell(5, "Direction allowed", biasLong ? "LONGS" : biasShort ? "SHORTS" : "none (bias conflict)", biasLong ? color.lime : biasShort ? color.orange : color.gray)
    f_cell(6, "ATR / session", (dOk ? "ok" : "filtered") + " / " + sessTxt, eOk and dOk ? color.lime : color.gray)
    f_cell(7, "Status", status, statC)
    f_cell(8, "Today setups / losses", str.tostring(daySignals) + "/" + str.tostring(maxSigDay) + "   " + str.tostring(dayLosses) + "/" + str.tostring(maxLossDay) + "   " + (dayR >= 0 ? "+" : "") + str.tostring(dayR, "0.0") + "R", dayLosses > 0 ? color.orange : color.white)
    f_cell(9, "Levels", openDir == 0 and pendDir == 0 ? "—" : "E " + str.tostring(lvl, format.mintick) + " SL " + str.tostring(slPx, format.mintick), color.white)
    f_cell(10, "Simulated W / L", str.tostring(totWins) + " / " + str.tostring(totLosses) + "   " + (totR >= 0 ? "+" : "") + str.tostring(totR, "0.0") + "R", totR >= 0 ? color.lime : color.orange)
    f_cell(11, "Risk", str.tostring(riskPct, "0.00") + "% of " + str.tostring(equity, "0") + " USD", color.white)
