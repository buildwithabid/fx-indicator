//@version=6
// Risk-Averse FX Day Trader v1 — STRATEGY (for the built-in tester). Generated by pine/build.py from pine/core.pine.
// Note: the tester resolves same-bar SL+TP optimistically and has no spread; slippage below approximates spread+slippage.
// Python backtest (py/) is the source of truth for expectancy; use this for visual checks and the trade list export.
strategy("Risk-Averse FX Day Trader v1 [strategy]", "RAFX v1 S", overlay=true, initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=10000, slippage=7, commission_type=strategy.commission.cash_per_contract,
     commission_value=0, process_orders_on_close=false, calc_on_every_tick=false, max_labels_count=500, max_lines_count=500,
     calc_bars_count=20000)
// Risk-Averse FX Day Trader v1 — shared core. Do not edit dist/*.pine; edit this and run pine/build.py.
// Lines starting with "//$I " are indicator-only, "//$S " strategy-only (build.py uncomments them).
// Rules: spec/rules_v1.md. Python mirror: py/fx/rules.py + py/fx/engine.py.

// ───────────────────────────── Inputs
grpR = "Risk"
atrSlMult      = input.float(1.5,   "Stop = max(ATR × this, swing + 0.1 ATR)", minval=0.5, step=0.1, group=grpR)
tpR            = input.float(2.0,   "Take profit (R multiple)",                minval=0.5, step=0.25, group=grpR)
equity         = input.float(10000, "Account equity (USD)",                    minval=1,   group=grpR)
riskPct        = input.float(0.5,   "Risk per trade (%)",                      minval=0.05, step=0.05, group=grpR)
spreadPips     = input.float(1.0,   "Spread + slippage assumed on entry (pips)", minval=0, step=0.1, group=grpR)
pipValOverride = input.float(0,     "Pip value per 1.0 lot in USD (0 = auto)", minval=0, group=grpR)
maxSigDay      = input.int(2,       "Max signals per day",                     minval=1, group=grpR)
minBarsBetween = input.int(8,       "Min bars between signals",                minval=1, group=grpR)
maxLossDay     = input.int(2,       "Go silent after N losses in a day",       minval=1, group=grpR)
maxDayR        = input.float(2.0,   "Go silent after day loss of R ≥",         minval=0.5, step=0.5, group=grpR)

grpF = "Filters (all times UTC)"
adxMin        = input.float(20, "1H ADX minimum", minval=5, step=1, group=grpF)
sess1         = input.session("0715-1045", "Session 1", group=grpF)
sess2         = input.session("1345-1600", "Session 2", group=grpF)
news1         = input.session("1225-1305", "News blackout 1 (US data 12:30)", group=grpF)
news2         = input.session("1355-1420", "News blackout 2 (US data 14:00)", group=grpF)
fridayCutoff  = input.int(15, "Friday: no signals from hour", minval=0, maxval=23, group=grpF)
blackoutDates = input.string("", "Blackout dates (YYYY-MM-DD, comma separated: NFP, FOMC, CPI)", group=grpF)

grpD = "Display"
dispTz     = input.string("Asia/Karachi", "Display timezone", group=grpD)
showTable  = input.bool(true, "Show status table", group=grpD)
showLines  = input.bool(true, "Draw SL/TP lines", group=grpD)
showEmas   = input.bool(true, "Plot 15m EMA20/50", group=grpD)

// ───────────────────────────── Frozen parameters (spec v1)
EMA_PULL   = 20
EMA_STRUCT = 50
PULL_WIN   = 6
RSI_LEN    = 14
RSI_VETO   = 70.0
ATR_LEN    = 14
ATR_PCT_N  = 480
ATR_PCT_LO = 20
ATR_PCT_HI = 95
SPIKE_MULT = 3.0
SWING_LEN  = 10
SWING_BUF  = 0.1

// ───────────────────────────── 15m indicators (always computed, global scope)
ema20    = ta.ema(close, EMA_PULL)
ema50    = ta.ema(close, EMA_STRUCT)
rsi      = ta.rsi(close, RSI_LEN)
atr      = ta.atr(ATR_LEN)
atrLo    = ta.percentile_nearest_rank(atr, ATR_PCT_N, ATR_PCT_LO)
atrHi    = ta.percentile_nearest_rank(atr, ATR_PCT_N, ATR_PCT_HI)
rng      = high - low
body     = math.abs(close - open)
spike    = rng > SPIKE_MULT * atr[1]
spikeRecent = spike or spike[1] or spike[2] or spike[3]
swingLow  = ta.lowest(low, SWING_LEN)
swingHigh = ta.highest(high, SWING_LEN)
lowestClose  = ta.lowest(close, PULL_WIN)
highestClose = ta.highest(close, PULL_WIN)
sinceTouchLo = ta.barssince(low <= ema20)
sinceTouchHi = ta.barssince(high >= ema20)

// ───────────────────────────── HTF (last CLOSED bar => non-repainting)
f_adx() =>
    [_dp, _dm, ax] = ta.dmi(14, 14)
    ax
[h4Fast, h4Slow, h4Close] = request.security(syminfo.tickerid, "240", [ta.ema(close, 50)[1], ta.ema(close, 200)[1], close[1]], lookahead=barmerge.lookahead_on)
h1Adx = request.security(syminfo.tickerid, "60", f_adx()[1], lookahead=barmerge.lookahead_on)

// ───────────────────────────── Gates
// A. 4H regime
aLong  = h4Fast > h4Slow and h4Close > h4Fast
aShort = h4Fast < h4Slow and h4Close < h4Fast
// B. 1H strength
bOk = h1Adx > adxMin
// C. pullback + confirmation
cPullLong  = sinceTouchLo <= PULL_WIN - 1 and lowestClose > ema50
cPullShort = sinceTouchHi <= PULL_WIN - 1 and highestClose < ema50
cConfLong  = close > open and close > high[1] and body >= 0.5 * rng and rng > 0 and rsi < RSI_VETO
cConfShort = close < open and close < low[1]  and body >= 0.5 * rng and rng > 0 and rsi > 100 - RSI_VETO
cLong  = cPullLong and cConfLong
cShort = cPullShort and cConfShort
// D. volatility
dOk = atr >= atrLo and atr <= atrHi and not spikeRecent
// E. session (bar open time, UTC)
inSess  = not na(time(timeframe.period, sess1 + ":23456", "UTC")) or not na(time(timeframe.period, sess2 + ":23456", "UTC"))
inNews  = not na(time(timeframe.period, news1 + ":23456", "UTC")) or not na(time(timeframe.period, news2 + ":23456", "UTC"))
utcHour = hour(time, "UTC")
utcDow  = dayofweek(time, "UTC")
fridayBlock = utcDow == dayofweek.friday and utcHour >= fridayCutoff
var string[] blackoutArr = str.split(str.replace_all(blackoutDates, " ", ""), ",")
todayStr = str.format_time(time, "yyyy-MM-dd", "UTC")
dateBlocked = blackoutDates != "" and array.includes(blackoutArr, todayStr)
eOk = inSess and not inNews and not fridayBlock and not dateBlocked
// Quality badge (display only)
qBase  = (rsi >= 40 and rsi <= 60 ? 1 : 0) + (rng > 0 and body >= 0.7 * rng ? 1 : 0)
qLong  = qBase + (lowestClose - ema50 >= 0.25 * atr ? 1 : 0)
qShort = qBase + (ema50 - highestClose >= 0.25 * atr ? 1 : 0)

candLong  = aLong  and bOk and cLong  and dOk and eOk
candShort = aShort and bOk and cShort and dOk and eOk

// ───────────────────────────── Lot sizing
pipSize = syminfo.mintick * 10
f_pipValueUsd() =>
    // USD per pip per 1.0 standard lot (100k units), for a USD account
    float v = na
    if pipValOverride > 0
        v := pipValOverride
    else if syminfo.currency == "USD"
        v := 100000 * pipSize
    else if syminfo.basecurrency == "USD"
        v := 100000 * pipSize / close
    else
        v := 100000 * pipSize   // cross pair: approximate, use override input
    v
f_lots(float dist) =>
    slPips = dist / pipSize
    raw = (equity * riskPct / 100) / (slPips * f_pipValueUsd())
    math.floor(raw * 100) / 100

// ───────────────────────────── State (updated on confirmed bars only)
var int   openDir    = 0
var int   pendingDir = 0
var float entryRef   = na
var float fill       = na
var float slPx       = na
var float tpPx       = na
var float slDist     = na
var int   entryBar   = na
var int   sigQuality = 0
var int   lastSigBar = -100000
var int   daySignals = 0
var int   dayLosses  = 0
var float dayR       = 0.0
var bool  dayStopped = false
var int   totWins    = 0
var int   totLosses  = 0
var float totR       = 0.0
var line  slLine     = na
var line  tpLine     = na
var label sigLabel   = na

dayKey = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
newDay = ta.change(dayKey) != 0

spreadPx = spreadPips * pipSize
bool sigLongNow  = false
bool sigShortNow = false
bool exitWinNow  = false
bool exitLossNow = false

if barstate.isconfirmed
    // 0. daily reset
    if newDay
        daySignals := 0
        dayLosses  := 0
        dayR       := 0.0
        dayStopped := false
    // 1. fill pending entry at this bar's open
    if pendingDir != 0
        openDir    := pendingDir
        pendingDir := 0
        fill       := openDir > 0 ? open + spreadPx : open - spreadPx
        entryBar   := bar_index
    // 2. manage open trade: SL first, then TP (worst case)
    if openDir != 0
        bool hitSl = openDir > 0 ? low <= slPx  : high >= slPx
        bool hitTp = openDir > 0 ? high >= tpPx : low <= tpPx
        if hitSl or hitTp
            float exitPx = hitSl ? slPx : tpPx
            float r = (exitPx - fill) / slDist * openDir
            dayR  += r
            totR  += r
            if r < 0
                dayLosses += 1
                totLosses += 1
                exitLossNow := true
            else
                totWins += 1
                exitWinNow := true
            if dayLosses >= maxLossDay or dayR <= -maxDayR
                dayStopped := true
            if showLines and not na(slLine)
                line.set_x2(slLine, bar_index)
                line.set_x2(tpLine, bar_index)
            label.new(bar_index, hitSl ? low : high, (hitSl ? "SL " : "TP ") + (r >= 0 ? "+" : "") + str.tostring(r, "0.00") + "R",
                 style=hitSl ? label.style_label_up : label.style_label_down,
                 color=hitSl ? color.new(color.red, 20) : color.new(color.teal, 20), textcolor=color.white, size=size.small)
            openDir := 0
    // 3. new signal?
    bool throttleOk = openDir == 0 and pendingDir == 0 and not dayStopped and daySignals < maxSigDay and bar_index - lastSigBar >= minBarsBetween
    if throttleOk and not na(atr) and not na(swingLow) and not na(atrLo) and (candLong or candShort)
        int d = candLong ? 1 : -1
        slDist   := d > 0 ? math.max(atrSlMult * atr, close - swingLow + SWING_BUF * atr) : math.max(atrSlMult * atr, swingHigh - close + SWING_BUF * atr)
        entryRef := close
        slPx     := close - d * slDist
        tpPx     := close + d * tpR * slDist
        sigQuality := d > 0 ? qLong : qShort
        pendingDir := d
        lastSigBar := bar_index
        daySignals += 1
        sigLongNow  := d > 0
        sigShortNow := d < 0
        float lots = f_lots(slDist)
        string txt = (d > 0 ? "▲ LONG" : "▼ SHORT") + "  Q" + str.tostring(sigQuality) + "/3" +
             "\nEntry " + str.tostring(entryRef, format.mintick) +
             "\nSL " + str.tostring(slPx, format.mintick) + " (" + str.tostring(slDist / pipSize, "0.0") + "p)" +
             "\nTP " + str.tostring(tpPx, format.mintick) + " (" + str.tostring(tpR, "0.0") + "R)" +
             "\n" + str.tostring(lots, "0.00") + " lot @ " + str.tostring(riskPct, "0.00") + "%"
        sigLabel := label.new(bar_index, d > 0 ? low : high, txt, style=d > 0 ? label.style_label_up : label.style_label_down,
             color=d > 0 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor=color.white, size=size.normal)
        if showLines
            slLine := line.new(bar_index, slPx, bar_index + 1, slPx, color=color.red, width=2)
            tpLine := line.new(bar_index, tpPx, bar_index + 1, tpPx, color=color.teal, width=2)
        string amsg = syminfo.ticker + " " + (d > 0 ? "LONG" : "SHORT") + " | entry " + str.tostring(entryRef, format.mintick) +
             " | SL " + str.tostring(slPx, format.mintick) + " | TP " + str.tostring(tpPx, format.mintick) +
             " | " + str.tostring(lots, "0.00") + " lot | Q" + str.tostring(sigQuality) + "/3 | " +
             str.format_time(time_close, "HH:mm", dispTz) + " " + dispTz
        alert(amsg, alert.freq_once_per_bar_close)
        if d > 0
            strategy.entry("L", strategy.long, qty=lots * 100000)
            strategy.exit("L-x", "L", stop=slPx, limit=tpPx)
        else
            strategy.entry("S", strategy.short, qty=lots * 100000)
            strategy.exit("S-x", "S", stop=slPx, limit=tpPx)
    // extend open-trade lines
    if openDir != 0 and showLines and not na(slLine)
        line.set_x2(slLine, bar_index + 1)
        line.set_x2(tpLine, bar_index + 1)

// ───────────────────────────── Plots
plot(showEmas ? ema20 : na, "EMA20", color=color.new(color.orange, 0), linewidth=1)
plot(showEmas ? ema50 : na, "EMA50", color=color.new(color.blue, 0), linewidth=1)
bgcolor(eOk ? color.new(color.green, 94) : na, title="Allowed session")
bgcolor(inNews and inSess ? color.new(color.red, 88) : na, title="News blackout")
plotshape(sigLongNow,  "Long signal",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(sigShortNow, "Short signal", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small)

// ───────────────────────────── Alerts (static, for the free-plan alert dialog)
alertcondition(sigLongNow,  "Long signal",  "Long signal on {{ticker}} — open chart for SL/TP/lots")
alertcondition(sigShortNow, "Short signal", "Short signal on {{ticker}} — open chart for SL/TP/lots")
alertcondition(sigLongNow or sigShortNow, "Any signal", "Signal on {{ticker}} — open chart for SL/TP/lots")

// ───────────────────────────── Status table
var table tbl = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.new(color.gray, 60))
f_cell(int r, string k, string v, color c) =>
    table.cell(tbl, 0, r, k, text_color=color.new(color.white, 30), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)
if showTable and barstate.islast
    string regime = aLong ? "BULL (longs only)" : aShort ? "BEAR (shorts only)" : "NONE (no trades)"
    color  regC   = aLong ? color.lime : aShort ? color.orange : color.gray
    string atrTxt = na(atrLo) ? "warming up" : atr < atrLo ? "too quiet" : atr > atrHi ? "too wild" : "ok"
    string sessTxt = not inSess ? "closed" : inNews ? "NEWS BLACKOUT" : fridayBlock ? "Friday cutoff" : dateBlocked ? "blackout date" : "OPEN"
    string status = openDir != 0 ? "IN TRADE (" + (openDir > 0 ? "long" : "short") + ")" : pendingDir != 0 ? "entering next bar" : dayStopped ? "DAY STOPPED" : eOk ? "watching" : "waiting for session"
    color statC = dayStopped ? color.red : openDir != 0 ? color.yellow : eOk ? color.lime : color.gray
    f_cell(0, "Risk-Averse FX v1", str.format_time(timenow, "EEE HH:mm", dispTz) + " " + dispTz, color.white)
    f_cell(1, "4H regime", regime, regC)
    f_cell(2, "1H ADX", str.tostring(h1Adx, "0.0") + (bOk ? " ✓" : " ✗ (< " + str.tostring(adxMin, "0") + ")"), bOk ? color.lime : color.gray)
    f_cell(3, "ATR filter", atrTxt + (spikeRecent ? " • spike cooldown" : ""), dOk ? color.lime : color.gray)
    f_cell(4, "Session (UTC " + str.format_time(timenow, "HH:mm", "UTC") + ")", sessTxt, eOk ? color.lime : color.gray)
    f_cell(5, "Status", status, statC)
    f_cell(6, "Today signals", str.tostring(daySignals) + " / " + str.tostring(maxSigDay), color.white)
    f_cell(7, "Today losses / R", str.tostring(dayLosses) + " / " + str.tostring(maxLossDay) + "   " + (dayR >= 0 ? "+" : "") + str.tostring(dayR, "0.0") + "R", dayLosses > 0 ? color.orange : color.white)
    f_cell(8, "Open trade", openDir == 0 ? "—" : "SL " + str.tostring(slPx, format.mintick) + "  TP " + str.tostring(tpPx, format.mintick), color.white)
    f_cell(9, "Simulated W / L", str.tostring(totWins) + " / " + str.tostring(totLosses) + "   " + (totR >= 0 ? "+" : "") + str.tostring(totR, "0.0") + "R", totR >= 0 ? color.lime : color.orange)
    f_cell(10, "Risk", str.tostring(riskPct, "0.00") + "% of " + str.tostring(equity, "0") + " USD", color.white)
